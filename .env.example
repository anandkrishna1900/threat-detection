# =============================================================================
# Environment Variables — copy this file to .env and fill in values
# =============================================================================

# --- Application ---
APP_ENV=development          # development | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | console (console is human-readable)

# --- Database ---
DATABASE_URL=sqlite:///./data/threat_detection.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true              # set false in production

# --- Model ---
MODEL_DIR=./models
MODEL_VERSION=v1

# --- Detection (global switches) ---
RULES_ENABLED=true
ML_ENABLED=true
BEHAVIORAL_ENABLED=true
